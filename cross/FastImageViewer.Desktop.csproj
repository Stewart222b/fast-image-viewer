    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>FastImageViewer.Desktop</RootNamespace>
    <AssemblyName>FastImageViewer</AssemblyName>
    <Version>0.3.0</Version>
