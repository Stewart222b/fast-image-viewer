<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FastImageViewer.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Foreground" Value="#262626" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover">
      <Setter Property="Background" Value="#E1E1E1" />
    </Style>
    <Style Selector="Button.tool:pressed">
      <Setter Property="Background" Value="#D6D6D6" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.tool:focus">
      <Setter Property="BorderBrush" Value="#0078D4" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Application.Styles>
</Application>
