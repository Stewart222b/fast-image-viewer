<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- build.ps1 compiles these files with csc /langversion:5. Keep this syntax level. -->
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>FastImageViewer</RootNamespace>
    <AssemblyName>FastImageViewer.Core</AssemblyName>
    <Version>0.3.0</Version>
    <Description>Shared viewport, wheel zoom, and file list for Fast Image Viewer.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
